        "commence",
        "endeavor",
        "ascertain",
        "subsequently",
        "aforementioned",
        "furthermore",
        "moreover",
        "nevertheless",
        "utilization"
      ]
    }
  ],
  "measures": {
    "note": "Continuous register signals rather than countable tells. These are what issue #37 is actually about: uniform sentence length and dense nominalised prose are the register, and no word list detects them.",
