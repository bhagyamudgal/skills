.DS_Store
node_modules

# Claude Code local state — runtime locks and per-machine overrides.
# Shared config like .claude/settings.json stays tracked; only ignore local/runtime files.
.claude/scheduled_tasks.lock
.claude/settings.local.json
.claude/.credentials.json

# review-pr writes per-PR review caches into its own skill dir.
# These contain real PR content — never commit them.
skills/*/cache/

__pycache__/

# The replay benchmark is private, adjudicated PR-review data. It is passed in by path
# (--benchmark / REVIEW_PR_BENCHMARK) and must never land in this public repo, nor may
# any run output derived from it.
tools/replay/data/
tools/replay/results/
tools/replay/*.local.json
