.DS_Store
node_modules

# Claude Code local state — runtime locks and per-machine overrides.
# Shared config like .claude/settings.json stays tracked; only ignore local/runtime files.
.claude/scheduled_tasks.lock
.claude/settings.local.json
.claude/.credentials.json

# review-pr writes per-PR review caches into its own skill dir.
# These contain real PR content — never commit them.
skills/*/cache/

__pycache__/
.eval-results/
